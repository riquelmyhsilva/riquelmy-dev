---
import BaseLayout from '@layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('pt');
---

<BaseLayout
  title={t('404.title')}
  description={t('404.message')}
  lang="pt"
  noindex={true}
>
  <section class="not-found container-main">
    <h1 class="not-found__code">404</h1>
    <p class="not-found__message" id="not-found-message">
      A página que você está procurando não existe. / The page you are looking for does not exist.
    </p>
    <a href="/" class="not-found__link" id="not-found-link">
      Voltar para o início / Return home
    </a>
  </section>

  <script>
    function localize404() {
      const isEn = window.location.pathname.startsWith('/en');
      const msg = document.getElementById('not-found-message');
      const link = document.getElementById('not-found-link');
      if (!msg || !link) return;

      if (isEn) {
        msg.textContent = 'The page you are looking for does not exist.';
        link.textContent = 'Return home';
        link.setAttribute('href', '/en');
      } else {
        msg.textContent = 'A página que você está procurando não existe.';
        link.textContent = 'Voltar para o início';
        link.setAttribute('href', '/');
      }
    }

    localize404();
    document.addEventListener('astro:page-load', localize404);
  </script>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 50vh;
    padding-top: 4rem;
    padding-bottom: 4rem;
  }

  .not-found__code {
    font-size: 6rem;
    font-weight: 700;
    line-height: 1;
    margin: 0 0 1rem;
    letter-spacing: -0.04em;
    color: var(--color-text-muted);
  }

  .not-found__message {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    margin: 0 0 2rem;
    max-width: 480px;
  }

  .not-found__link {
    display: inline-flex;
    align-items: center;
    padding: 0.625rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 8px;
    background-color: var(--color-accent);
    color: #fff;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .not-found__link:hover {
    background-color: var(--color-accent-hover);
    color: #fff;
  }
</style>
