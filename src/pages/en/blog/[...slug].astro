---
import ArticleLayout from '@layouts/ArticleLayout.astro';
import { getCollection, render } from 'astro:content';
import { getLocalizedReadingTime } from '../../../i18n/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ id, data }) => !data.draft && id.startsWith('en/'));
  const sorted = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return sorted.map((post, index) => {
    const cleanSlug = post.id.replace(/^en\//, '');
    return {
      params: { slug: cleanSlug },
      props: {
        post,
        prevPost: index < sorted.length - 1
          ? { slug: sorted[index + 1].id.replace(/^en\//, ''), title: sorted[index + 1].data.title }
          : null,
        nextPost: index > 0
          ? { slug: sorted[index - 1].id.replace(/^en\//, ''), title: sorted[index - 1].data.title }
          : null,
      },
    };
  });
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
const readingTime = getLocalizedReadingTime(post.body ?? '', 'en');
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  tags={post.data.tags}
  readingTime={readingTime}
  headings={headings}
  prevPost={prevPost}
  nextPost={nextPost}
  lang="en"
>
  <Content />
</ArticleLayout>
