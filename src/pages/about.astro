---
import BaseLayout from '@layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('pt');

const skills = [
  {
    category: t('about.skills.ai'),
    items: ['LLMs (Gemini, Claude)', 'RAG', 'Tool Calling', 'Guardrails', 'Automated Evals (pytest)', 'Transformers / BERT', 'FastAPI', 'Hugging Face'],
  },
  {
    category: t('about.skills.ds'),
    items: ['Python', 'scikit-learn', 'XGBoost', 'pandas', 'NumPy', 'TensorFlow', 'statsmodels'],
  },
  {
    category: t('about.skills.de'),
    items: ['SQL', 'Apache Spark', 'Airflow', 'dbt', 'ETL pipelines', 'Modelagem de dados'],
  },
  {
    category: t('about.skills.bi'),
    items: ['Power BI', 'Microsoft Fabric', 'DAX', 'Power Query', 'SSAS', 'Design de relatórios'],
  },
  {
    category: t('about.skills.prog'),
    items: ['Python', 'TypeScript', 'SQL', 'Bash', 'Git', 'REST APIs'],
  },
  {
    category: t('about.skills.infra'),
    items: ['Linux', 'Docker', 'CI/CD', 'Azure', 'PostgreSQL', 'Firebase'],
  },
];
---

<BaseLayout
  title={`${t('about.title')} | Riquelmy`}
  description={t('about.metaDesc')}
  lang="pt"
>
  <section class="about-page container-main">
    <header class="about-page__header">
      <h1 class="about-page__title">{t('about.title')}</h1>
    </header>

    <div class="about-page__content container-article">
      <div class="about-page__bio">
        <p>{t('about.bio1')}</p>
        <p>{t('about.bio2')}</p>
        <p>{t('about.bio3')}</p>
      </div>

      <div class="about-page__section">
        <h2 class="about-page__subtitle">{t('about.focusTitle')}</h2>
        <ul class="about-page__focus-list">
          <li>{t('about.focus1')}</li>
          <li>{t('about.focus2')}</li>
          <li>{t('about.focus3')}</li>
          <li>{t('about.focus4')}</li>
          <li>{t('about.focus5')}</li>
        </ul>
      </div>

      <div class="about-page__section">
        <h2 class="about-page__subtitle">{t('about.skillsTitle')}</h2>
        <div class="about-page__skills">
          {skills.map(({ category, items }) => (
            <div class="skill-group">
              <h3 class="skill-group__title">{category}</h3>
              <div class="skill-group__items">
                {items.map((item) => (
                  <span class="skill-group__tag">{item}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="about-page__section">
        <h2 class="about-page__subtitle">{t('about.contactTitle')}</h2>
        <p>
          {t('about.contactP1')} <a href="https://github.com/riquelmyhsilva" target="_blank" rel="noopener noreferrer">GitHub</a>
          {t('about.contactP2')} <a href="https://www.linkedin.com/in/riquelmyhsilva/" target="_blank" rel="noopener noreferrer">LinkedIn</a>{t('about.contactP3')} <a href="/rss.xml">feed RSS</a> {t('about.contactP4')}
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    padding-top: 3rem;
    padding-bottom: 2rem;
  }

  .about-page__header {
    margin-bottom: 2.5rem;
  }

  .about-page__title {
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .about-page__bio {
    margin-bottom: 3rem;
  }

  .about-page__bio p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin: 0 0 1rem;
  }

  .about-page__bio p:last-child {
    margin-bottom: 0;
  }

  .about-page__section {
    margin-bottom: 3rem;
  }

  .about-page__subtitle {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .about-page__focus-list {
    padding-left: 1.25rem;
    margin: 0;
  }

  .about-page__focus-list li {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 0.5rem;
  }

  .about-page__skills {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .about-page__skills {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .skill-group__title {
    font-size: 0.875rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: var(--color-text);
  }

  .skill-group__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .skill-group__tag {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    background-color: var(--color-tag-bg);
    color: var(--color-tag-text);
  }

  .about-page__section p {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }
</style>
