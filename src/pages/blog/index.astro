---
import BaseLayout from '@layouts/BaseLayout.astro';
import ArticleCard from '@components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { getLocalizedReadingTime, useTranslations } from '../../i18n/utils';

const t = useTranslations('pt');

const allPosts = await getCollection('blog', ({ id, data }) => !data.draft && id.startsWith('pt/'));
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Collect all unique tags
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<BaseLayout
  title={`${t('blog.title')} | Riquelmy`}
  description={t('blog.metaDesc')}
  lang="pt"
>
  <section class="blog-page container-main">
    <header class="blog-page__header">
      <h1 class="blog-page__title">{t('blog.title')}</h1>
      <p class="blog-page__desc">
        {t('blog.desc')}
      </p>
    </header>

    <!-- Tag filter -->
    {allTags.length > 0 && (
      <div class="blog-page__filters" id="tag-filters" role="group" aria-label="Filtrar artigos por tag">
        <button class="filter-tag filter-tag--active" data-tag="all" type="button" aria-pressed="true">{t('blog.filterAll')}</button>
        {allTags.map((tag) => (
          <button class="filter-tag" data-tag={tag} type="button" aria-pressed="false">{tag}</button>
        ))}
      </div>
    )}

    <!-- Article list -->
    <div class="blog-page__list" id="articles-list">
      {posts.map((post) => (
        <div class="blog-page__item" data-tags={post.data.tags.join(',')}>
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            tags={post.data.tags}
            readingTime={getLocalizedReadingTime(post.body ?? '', 'pt')}
            slug={post.id}
            lang="pt"
          />
        </div>
      ))}
    </div>

    {posts.length === 0 && (
      <p class="blog-page__empty">{t('blog.empty')}</p>
    )}
  </section>

  <script>
    function initBlogFilters() {
      const filters = document.getElementById('tag-filters');
      const items = document.querySelectorAll<HTMLElement>('#articles-list .blog-page__item');
      if (!filters) return;

      const buttons = Array.from(filters.querySelectorAll<HTMLButtonElement>('.filter-tag'));
      const validTags = new Set(buttons.map((btn) => btn.getAttribute('data-tag') ?? ''));

      const params = new URLSearchParams(window.location.search);
      const requested = params.get('tag') || 'all';
      const initial = validTags.has(requested) ? requested : 'all';

      function activate(tag: string) {
        const resolvedTag = validTags.has(tag) ? tag : 'all';

        buttons.forEach((btn) => {
          const isSelected = btn.getAttribute('data-tag') === resolvedTag;
          btn.classList.toggle('filter-tag--active', isSelected);
          btn.setAttribute('aria-pressed', String(isSelected));
        });

        items.forEach((item) => {
          if (resolvedTag === 'all') {
            item.style.display = '';
          } else {
            const tags = (item.getAttribute('data-tags') || '').split(',');
            item.style.display = tags.includes(resolvedTag) ? '' : 'none';
          }
        });

        const url = new URL(window.location.href);
        if (resolvedTag === 'all') {
          url.searchParams.delete('tag');
        } else {
          url.searchParams.set('tag', resolvedTag);
        }
        history.replaceState(null, '', url);
      }

      activate(initial);

      if (filters.dataset.bound !== 'true') {
        filters.dataset.bound = 'true';
        filters.addEventListener('click', (e) => {
          if (!(e.target instanceof Element)) return;
          const btn = e.target.closest<HTMLButtonElement>('.filter-tag');
          if (btn) activate(btn.getAttribute('data-tag') || 'all');
        });
      }
    }

    initBlogFilters();
    document.addEventListener('astro:page-load', initBlogFilters);
  </script>
</BaseLayout>

<style>
  .blog-page {
    padding-top: 3rem;
    padding-bottom: 2rem;
  }

  .blog-page__header {
    margin-bottom: 2rem;
  }

  .blog-page__title {
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }

  .blog-page__desc {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .blog-page__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .filter-tag {
    padding: 0.3rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.15s ease;
    font-family: var(--font-sans);
  }

  .filter-tag:hover {
    border-color: var(--color-text-muted);
    color: var(--color-text);
  }

  .filter-tag--active {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }

  .filter-tag--active:hover {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    color: #fff;
  }

  .blog-page__list {
    display: grid;
    gap: 1rem;
  }

  .blog-page__empty {
    font-size: 1rem;
    color: var(--color-text-muted);
    text-align: center;
    padding: 3rem 0;
  }
</style>
