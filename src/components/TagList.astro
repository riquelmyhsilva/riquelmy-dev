---
import { getLangFromUrl, type Language } from '../i18n/utils';

interface Props {
  tags: string[];
  linked?: boolean;
  lang?: Language;
}

const { tags, linked = false, lang: explicitLang } = Astro.props;
const lang = explicitLang ?? getLangFromUrl(Astro.url);
const blogHref = lang === 'en' ? '/en/blog' : '/blog';
---

<ul class="tag-list" role="list">
  {tags.map((tag) => (
    <li>
      {linked ? (
        <a href={`${blogHref}?tag=${encodeURIComponent(tag)}`} class="tag">{tag}</a>
      ) : (
        <span class="tag">{tag}</span>
      )}
    </li>
  ))}
</ul>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tag {
    display: inline-block;
    padding: 0.2rem 0.65rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    border-radius: 4px;
    background-color: var(--color-tag-bg);
    color: var(--color-tag-text);
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  a.tag:hover {
    background-color: var(--color-accent-muted);
    color: var(--color-accent);
  }
</style>
