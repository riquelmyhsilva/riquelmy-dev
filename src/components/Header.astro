---
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from './LanguageToggle.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const prefix = lang === 'en' ? '/en' : '';
const homeHref = lang === 'en' ? '/en' : '/';

const navLinks = [
  { href: `${prefix}/blog`, label: t('nav.blog') },
  { href: `${prefix}/projects`, label: t('nav.projects') },
  { href: `${prefix}/about`, label: t('nav.about') },
];

const currentPath = Astro.url.pathname;
---

<div class="header-spacer" aria-hidden="true"></div>
<header class="header" id="site-header" transition:animate="none">
  <div class="header__inner">
    <a href={homeHref} class="header__logo" aria-label="Home">
      riquelmy.dev
    </a>

    <nav class="header__nav" id="main-nav" aria-label="Main navigation">
      <ul class="header__links" role="list">
        {navLinks.map(({ href, label }) => {
          const isActive = currentPath === href || (href !== '/' && href !== '/en' && currentPath.startsWith(href));
          return (
            <li>
              <a
                href={href}
                class:list={['header__link', { 'header__link--active': isActive }]}
              >
                {label}
                {isActive && <span class="header__indicator" transition:name="nav-indicator" aria-hidden="true"></span>}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="header__actions">
      <LanguageToggle />
      <ThemeToggle />
      <button
        id="mobile-menu-toggle"
        class="header__burger"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="burger-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="22" height="22" aria-hidden="true">
          <line class="burger-line burger-line--top" x1="3" y1="6" x2="21" y2="6" />
          <line class="burger-line burger-line--mid" x1="3" y1="12" x2="21" y2="12" />
          <line class="burger-line burger-line--bot" x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile navigation" hidden>
    <div class="mobile-menu__inner">
      <ul class="mobile-menu__links" role="list">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={['mobile-menu__link', { 'mobile-menu__link--active': currentPath === href || (href !== '/' && href !== '/en' && currentPath.startsWith(href)) }]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<style>
  .header-spacer {
    height: var(--header-height, 3.75rem);
  }

  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    border-bottom: 1px solid var(--color-border);
    background-color: color-mix(in srgb, var(--color-bg) 85%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding: 0 var(--layout-gutter);
    height: var(--header-height, 3.75rem);
  }

  .header__logo {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .header__logo:hover {
    color: var(--color-accent);
  }

  .header__nav {
    display: none;
  }

  @media (min-width: 768px) {
    .header__nav {
      display: block;
    }
  }

  .header__links {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
    position: relative;
  }

  .header__link:hover {
    color: var(--color-text);
  }

  .header__link--active {
    color: var(--color-text);
  }

  .header__indicator {
    position: absolute;
    bottom: -1.2rem;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--color-accent);
    border-radius: 1px;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header__burger {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .header__burger:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  @media (min-width: 768px) {
    .header__burger {
      display: none;
    }
  }

  .burger-line {
    transition: transform 200ms cubic-bezier(0.23, 1, 0.32, 1), opacity 150ms ease;
  }

  .burger-line--top {
    transform-origin: 12px 6px;
  }

  .burger-line--mid {
    transform-origin: 12px 12px;
  }

  .burger-line--bot {
    transform-origin: 12px 18px;
  }

  .header__burger[aria-expanded="true"] .burger-line--top {
    transform: translateY(6px) rotate(45deg);
  }

  .header__burger[aria-expanded="true"] .burger-line--mid {
    opacity: 0;
    transform: scaleX(0.5);
  }

  .header__burger[aria-expanded="true"] .burger-line--bot {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Mobile menu — expands inside the single frosted-glass header surface */
  .mobile-menu {
    display: grid;
    grid-template-rows: 1fr;
    transition:
      grid-template-rows 240ms cubic-bezier(0.23, 1, 0.32, 1),
      display 240ms;
    transition-behavior: allow-discrete;
  }

  .mobile-menu__inner {
    overflow: hidden;
    padding: 0 var(--layout-gutter);
  }

  @starting-style {
    .mobile-menu {
      grid-template-rows: 0fr;
    }
  }

  .mobile-menu:where([hidden], [data-closing]) {
    grid-template-rows: 0fr;
    transition-duration: 180ms;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  @media (min-width: 768px) {
    .mobile-menu {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .burger-line {
      transition: opacity 120ms ease;
    }

    .mobile-menu {
      grid-template-rows: 1fr;
      opacity: 1;
      transition: opacity 100ms ease, display 100ms;
      transition-behavior: allow-discrete;
    }

    @starting-style {
      .mobile-menu {
        grid-template-rows: 1fr;
        opacity: 0;
      }
    }

    .mobile-menu:where([hidden], [data-closing]) {
      grid-template-rows: 1fr;
      opacity: 0;
      transition-duration: 100ms;
    }
  }

  .mobile-menu__links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0.75rem 0 1rem;
  }

  .mobile-menu__link {
    display: block;
    padding: 0.5rem 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: 6px;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .mobile-menu__link:hover {
    color: var(--color-text);
    background-color: var(--color-surface);
  }

  .mobile-menu__link--active {
    color: var(--color-accent);
    background-color: var(--color-surface);
  }
</style>

<script is:inline>
  (function() {
    if (window.__mobileMenuBound) return;
    window.__mobileMenuBound = true;

    var supportsDisplayTransition;
    function canTransitionDisplay() {
      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
      if (!window.CSS || typeof window.CSS.supports !== 'function' || !window.CSS.supports('transition-behavior', 'allow-discrete') || !document.body) {
        supportsDisplayTransition = false;
        return false;
      }
      var probe = document.createElement('div');
      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
      document.body.appendChild(probe);
      getComputedStyle(probe).display;
      probe.style.display = 'none';
      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
      probe.remove();
      return supportsDisplayTransition;
    }

    function getElements() {
      return {
        toggle: document.getElementById('mobile-menu-toggle'),
        menu: document.getElementById('mobile-menu'),
        header: document.getElementById('site-header')
      };
    }

    function setOpen(open, instant) {
      var els = getElements();
      if (!els.toggle || !els.menu) return;
      els.toggle.setAttribute('aria-expanded', String(open));

      if (open) {
        els.menu.removeAttribute('data-closing');
        els.menu.hidden = false;
        return;
      }

      if (instant || (els.menu.hidden && !els.menu.hasAttribute('data-closing'))) {
        els.menu.removeAttribute('data-closing');
        els.menu.hidden = true;
        return;
      }

      if (canTransitionDisplay()) {
        els.menu.hidden = true;
        return;
      }

      els.menu.setAttribute('data-closing', '');
      var animations = typeof els.menu.getAnimations === 'function' ? els.menu.getAnimations() : [];
      if (animations.length === 0) {
        els.menu.removeAttribute('data-closing');
        els.menu.hidden = true;
        return;
      }

      Promise.race([
        Promise.allSettled(animations.map(function(a) { return a.finished; })),
        new Promise(function(resolve) { window.setTimeout(resolve, 250); })
      ]).then(function() {
        if (els.menu.hasAttribute('data-closing')) {
          els.menu.removeAttribute('data-closing');
          els.menu.hidden = true;
        }
      });
    }

    document.addEventListener('click', function(e) {
      var target = e.target;
      if (!(target instanceof Element)) return;

      var els = getElements();
      if (!els.toggle || !els.menu) return;

      if (target.closest('#mobile-menu-toggle')) {
        var expanded = els.toggle.getAttribute('aria-expanded') === 'true';
        setOpen(!expanded);
        return;
      }

      if (target.closest('.mobile-menu__link')) {
        setOpen(false, true);
        return;
      }

      if (
        els.toggle.getAttribute('aria-expanded') === 'true' &&
        els.header &&
        !els.header.contains(target) &&
        !els.menu.contains(target)
      ) {
        setOpen(false);
      }
    });

    document.addEventListener('keydown', function(e) {
      if (e.key !== 'Escape') return;
      var els = getElements();
      if (els.toggle && els.toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        els.toggle.focus();
      }
    });

    document.addEventListener('astro:before-swap', function() {
      setOpen(false, true);
    });
  })();
</script>
