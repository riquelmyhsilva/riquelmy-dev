---
import { getLangFromUrl, getLocalizedPath } from '../i18n/utils';

const currentPath = Astro.url.pathname;
const currentLang = getLangFromUrl(Astro.url);

const targetLang = currentLang === 'pt' ? 'en' : 'pt';
const targetHref = getLocalizedPath(currentPath, targetLang);
const targetLabel = targetLang === 'en' ? 'Switch to English' : 'Mudar para Português';
---

<a
  href={targetHref}
  class="lang-toggle"
  aria-label={targetLabel}
  title={targetLabel}
  data-lang={targetLang}
>
  <span class:list={['lang-toggle__opt', { 'lang-toggle__opt--active': currentLang === 'pt' }]}>
    PT
  </span>
  <span class:list={['lang-toggle__opt', { 'lang-toggle__opt--active': currentLang === 'en' }]}>
    EN
  </span>
</a>

<style>
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    height: 2.25rem;
    padding: 0 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: transparent;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    user-select: none;
    box-sizing: border-box;
    flex-shrink: 0;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .lang-toggle:hover {
    border-color: var(--color-text-muted);
    background-color: var(--color-surface);
  }

  .lang-toggle__opt {
    color: var(--color-text-muted);
    transition: color 0.15s ease;
  }

  .lang-toggle__opt--active {
    color: var(--color-text);
  }
</style>
