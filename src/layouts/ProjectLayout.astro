---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '@components/TableOfContents.astro';
import { getLangFromUrl, formatLocalizedDate, useTranslations, type Language } from '../i18n/utils';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  stack: string[];
  githubUrl?: string;
  liveUrl?: string;
  featured?: boolean;
  date?: Date;
  status?: string;
  role?: string;
  readingTime?: string;
  headings: Heading[];
  prevProject?: { slug: string; title: string } | null;
  nextProject?: { slug: string; title: string } | null;
  lang?: Language;
}

const {
  title,
  description,
  stack,
  githubUrl,
  liveUrl,
  featured,
  date,
  status,
  role,
  readingTime,
  headings,
  prevProject,
  nextProject,
  lang: explicitLang,
} = Astro.props;

const lang = explicitLang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const showToc = headings.filter((h) => h.depth >= 2 && h.depth <= 3).length >= 3;
const projectsPrefix = lang === 'en' ? '/en/projects' : '/projects';

const getCleanSlug = (slug: string) => slug.replace(/^(pt|en)\//, '');
---

<BaseLayout title={`${title} | Riquelmy Henrique Silva`} description={description} lang={lang}>
  <article class="project-page container-main">
    <header class="project-page__header container-article">
      <div class="project-page__top-bar">
        <a href={projectsPrefix} class="project-page__back">
          <span aria-hidden="true">←</span> {t('projects.backToProjects')}
        </a>

        {(featured || status || role || date || readingTime) && (
          <div class="project-page__meta">
            {featured && <span class="project-page__badge">{t('projects.featuredBadge')}</span>}
            {status && <span>{status}</span>}
            {role && <span>{role}</span>}
            {date && <time datetime={date.toISOString()}>{formatLocalizedDate(date, lang)}</time>}
            {readingTime && (
              <>
                {(featured || status || role || date) && (
                  <span class="project-page__sep" aria-hidden="true">/</span>
                )}
                <span>{readingTime}</span>
              </>
            )}
          </div>
        )}
      </div>

      <h1 class="project-page__title">{title}</h1>
      <p class="project-page__desc">{description}</p>

      <div class="project-page__stack">
        {stack.map((tech) => (
          <span class="project-page__tech">{tech}</span>
        ))}
      </div>

      {(githubUrl || liveUrl) && (
        <div class="project-page__actions">
          {githubUrl && (
            <a
              href={githubUrl}
              class="project-page__btn project-page__btn--primary"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.387.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.729.083-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.31.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.3 1.23A11.51 11.51 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.29-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.015 2.896-.015 3.286 0 .322.218.694.825.576C20.565 21.795 24 17.298 24 12c0-6.63-5.37-12-12-12z"/>
              </svg>
              {t('projects.source')}
            </a>
          )}
          {liveUrl && (
            <a
              href={liveUrl}
              class="project-page__btn project-page__btn--secondary"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
              {t('projects.live')}
            </a>
          )}
        </div>
      )}
    </header>

    <div class:list={['project-page__body', { 'project-page__body--with-toc': showToc }]}>
      {showToc && (
        <aside class="project-page__sidebar">
          <div class="project-page__toc-sticky">
            <TableOfContents headings={headings} lang={lang} />
          </div>
        </aside>
      )}
      <div class="project-page__content prose container-article">
        <slot />
      </div>
    </div>

    <nav
      class="project-page__nav container-article"
      aria-label={lang === 'en' ? 'Project navigation' : 'Navegação entre projetos'}
    >
      <div class="project-page__nav-item project-page__nav-prev">
        {prevProject && (
          <a href={`${projectsPrefix}/${getCleanSlug(prevProject.slug)}`}>
            <span class="project-page__nav-label">{t('projects.prev')}</span>
            <span class="project-page__nav-title">{prevProject.title}</span>
          </a>
        )}
      </div>
      <div class="project-page__nav-item project-page__nav-next">
        {nextProject && (
          <a href={`${projectsPrefix}/${getCleanSlug(nextProject.slug)}`}>
            <span class="project-page__nav-label">{t('projects.next')}</span>
            <span class="project-page__nav-title">{nextProject.title}</span>
          </a>
        )}
      </div>
    </nav>
  </article>
</BaseLayout>

<style>
  .project-page {
    padding-top: 3rem;
    padding-bottom: 2rem;
  }

  .project-page__header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .project-page__top-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .project-page__back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .project-page__back:hover {
    color: var(--color-accent);
  }

  .project-page__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .project-page__badge {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background-color: var(--color-accent-muted);
    color: var(--color-accent);
  }

  .project-page__sep {
    opacity: 0.4;
  }

  .project-page__title {
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 1rem;
    letter-spacing: -0.03em;
  }

  @media (max-width: 639px) {
    .project-page__title {
      font-size: 1.75rem;
    }
  }

  .project-page__desc {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0 0 1.25rem;
  }

  .project-page__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.5rem;
  }

  .project-page__tech {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    background-color: var(--color-tag-bg);
    color: var(--color-tag-text);
    letter-spacing: 0.01em;
  }

  .project-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .project-page__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.1rem;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .project-page__btn--primary {
    background-color: var(--color-accent);
    color: #ffffff;
  }

  .project-page__btn--primary:hover {
    background-color: var(--color-accent-hover);
    color: #ffffff;
  }

  .project-page__btn--secondary {
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    color: var(--color-text);
  }

  .project-page__btn--secondary:hover {
    border-color: var(--color-text-muted);
    color: var(--color-text);
  }

  /* Body layout with optional ToC sidebar */
  .project-page__body {
    position: relative;
  }

  .project-page__body--with-toc {
    display: block;
  }

  @media (min-width: 1200px) {
    .project-page__body--with-toc {
      display: grid;
      grid-template-columns: 1fr 220px;
      gap: 3rem;
      max-width: 1100px;
      margin: 0 auto;
    }
  }

  .project-page__sidebar {
    display: none;
  }

  @media (min-width: 1200px) {
    .project-page__sidebar {
      display: block;
      order: 2;
    }
  }

  .project-page__toc-sticky {
    position: sticky;
    top: 5rem;
  }

  .project-page__content {
    order: 1;
  }

  /* Prev / Next navigation */
  .project-page__nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .project-page__nav-item a {
    display: block;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .project-page__nav-item a:hover {
    border-color: var(--color-accent-muted);
    background-color: var(--color-surface);
  }

  .project-page__nav-next {
    text-align: right;
  }

  .project-page__nav-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }

  .project-page__nav-title {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.4;
  }
</style>
