---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { ClientRouter, fade } from 'astro:transitions';
import interLatinWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '@styles/global.css';
import { getLangFromUrl, getLocalizedPath, type Language } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  lang?: Language;
  noindex?: boolean;
  minimal?: boolean;
}

const {
  title,
  description,
  ogImage = '/og-default.png',
  lang: explicitLang,
  noindex = false,
  minimal = false,
} = Astro.props;
const lang = explicitLang ?? getLangFromUrl(Astro.url);
const htmlLang = lang === 'pt' ? 'pt-BR' : 'en';
const canonicalURL = !noindex ? new URL(Astro.url.pathname, Astro.site) : undefined;
const rssHref = lang === 'en' ? '/en/rss.xml' : '/rss.xml';
const ptAlternateURL = !noindex ? new URL(getLocalizedPath(Astro.url.pathname, 'pt'), Astro.site) : undefined;
const enAlternateURL = !noindex ? new URL(getLocalizedPath(Astro.url.pathname, 'en'), Astro.site) : undefined;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />

    <title>{title}</title>
    {!minimal && <ClientRouter />}
    <meta name="description" content={description} />

    {noindex ? (
      <>
        <meta name="robots" content="noindex, nofollow" />
        <meta name="googlebot" content="noindex, nofollow" />
      </>
    ) : (
      <>
        <link rel="canonical" href={canonicalURL} />
        <link rel="alternate" hreflang="pt-BR" href={ptAlternateURL} />
        <link rel="alternate" hreflang="en" href={enAlternateURL} />
        <link rel="alternate" hreflang="x-default" href={ptAlternateURL} />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL(ogImage, Astro.site)} />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

        <!-- RSS -->
        <link rel="alternate" type="application/rss+xml" title="RSS Feed" href={rssHref} />
      </>
    )}

    <!-- Critical Self-Hosted Font Preload -->
    <link rel="preload" href={interLatinWoff2} as="font" type="font/woff2" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Theme Initialization (prevents FOUC) -->
    <script is:inline data-astro-transition-persist="theme-init">
      (function () {
        function getStoredTheme() {
          try {
            return localStorage.getItem('theme');
          } catch {
            return null;
          }
        }
        function applyTheme() {
          const stored = getStoredTheme();
          const theme = (stored === 'light' || stored === 'dark')
            ? stored
            : (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          document.documentElement.classList.toggle('light', theme === 'light');
        }
        applyTheme();
        if (!window.__astroThemeSwapBound) {
          window.__astroThemeSwapBound = true;
          document.addEventListener('astro:after-swap', applyTheme);
        }
      })();
    </script>

    <slot name="head" />
  </head>
  <body>
    {minimal ? (
      <main id="main-content">
        <slot />
      </main>
    ) : (
      <>
        <Header />
        <main id="main-content" transition:animate={fade({ duration: '0.45s' })}>
          <slot />
        </main>
        <Footer />
      </>
    )}
  </body>
</html>
