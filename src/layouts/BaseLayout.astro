---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import '@styles/global.css';
import { getLangFromUrl, getLocalizedPath, type Language } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  lang?: Language;
}

const { title, description, ogImage = '/og-default.png', lang: explicitLang } = Astro.props;
const lang = explicitLang ?? getLangFromUrl(Astro.url);
const htmlLang = lang === 'pt' ? 'pt-BR' : 'en';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const rssHref = lang === 'en' ? '/en/rss.xml' : '/rss.xml';
const ptAlternateURL = new URL(getLocalizedPath(Astro.url.pathname, 'pt'), Astro.site);
const enAlternateURL = new URL(getLocalizedPath(Astro.url.pathname, 'en'), Astro.site);
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="pt-BR" href={ptAlternateURL} />
    <link rel="alternate" hreflang="en" href={enAlternateURL} />
    <link rel="alternate" hreflang="x-default" href={ptAlternateURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href={rssHref} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Theme Initialization (prevents FOUC) -->
    <script is:inline>
      (function() {
        const STORAGE_KEY = 'theme';
        const stored = localStorage.getItem(STORAGE_KEY);
        const theme = (stored === 'light' || stored === 'dark')
          ? stored
          : (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        if (theme === 'light') {
          document.documentElement.classList.add('light');
        }
      })();
    </script>

    <slot name="head" />
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
